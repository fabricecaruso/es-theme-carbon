<?xml version="1.0" encoding="UTF-8"?>
<theme>
  <formatVersion>7</formatVersion>
  <include>./imagegrid.xml</include>
  <view name="system" extraTransition="fade &amp; slide" extraTransitionSpeed="400" extraTransitionDirection="vertical">
    <imagegrid name="imagegrid">
      <groupBy>manufacturer</groupBy>
      <groupHeight>0.038</groupHeight>
      <groupBands>1</groupBands>
  <!--    <sortBy>lastPlayedDateTime</sortBy>
      <sortDescending>1</sortDescending>-->
    </imagegrid>
    <text name="gridgroup">
      <color>FFFFFFFF</color>
      <fontPath>${themePath}/art/fonts/Cabin-Regular.ttf</fontPath>
      <fontSize>0.022</fontSize>
      <verticalAlignment>top</verticalAlignment>
      <forceUppercase>1</forceUppercase>
    </text>
    
