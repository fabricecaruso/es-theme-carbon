<?xml version="1.0" encoding="UTF-8"?>
<theme>
  <formatVersion>7</formatVersion>
  <include>./imagegrid.xml</include>
  <subset name="groupgridby" displayName="Group System Grid By">
    <include name="manufacturer" displayName="Manufacturer"/>
    <include name="hardwareType" displayName="Hardware Type"/>
  </subset>
  <subset name="collectiongrouporder" displayName="Show System grid Collections At">
    <include name="alpha" displayName="Alphabetical"/>
    <include name="start" displayName="Start"/>
    <include name="end" displayName="End"/>
    <include name="customatstart" displayName="Custom collections at Start / Auto Collections at Bottom"/>
  </subset>
  <view name="system" extraTransition="fade &amp; slide" extraTransitionSpeed="400" extraTransitionDirection="vertical">
    <imagegrid name="imagegrid">
      <groupBy>manufacturer</groupBy>
      <groupBy ifSubset="groupgridby:hardwareType">hardwareType</groupBy>
      <groupHeight>0.038</groupHeight>
      <groupBands>1</groupBands>
      <groupsAtEnd>misc. system;system;retrobat</groupsAtEnd>
      <groupsAtStart ifSubset="collectiongrouporder:start">collections;custom collection;auto collection;custom collections</groupsAtStart>
      <groupsAtEnd ifSubset="collectiongrouporder:end">collections;custom collection;custom collections;auto collection;misc. system;system;retrobat</groupsAtEnd>
      <groupsAtStart ifSubset="collectiongrouporder:customatstart">custom collection;custom collections</groupsAtStart>
      <groupsAtEnd ifSubset="collectiongrouporder:customatstart">collections;auto collection;misc. system;system;retrobat</groupsAtEnd>
      <!--    <sortBy>lastPlayedDateTime</sortBy>
      <sortDescending>1</sortDescending>-->
    </imagegrid>
    <text name="gridgroup">
      <color>FFFFFFFF</color>
      <fontPath>${themePath}/art/fonts/Cabin-Regular.ttf</fontPath>
      <fontSize>0.022</fontSize>
      <verticalAlignment>top</verticalAlignment>
      <forceUppercase>1</forceUppercase>
    </text>
  </view>
</theme>
